# HeartStamp session credentials (extracted from your logged-in browser).
# See README.md "Extract your HS session credentials".
HS_XOXC_TOKEN=xoxc-your-token-here
HS_D_COOKIE=xoxd-your-cookie-here

# Bot token for YOUR own workspace (the mirror target).
TARGET_BOT_TOKEN=xoxb-your-bot-token-here

# App-level token (xapp-…) for Socket Mode. Only needed for the reverse relay
# (reply-back with approval). Leave blank if reverse_enabled is false.
TARGET_APP_TOKEN=
